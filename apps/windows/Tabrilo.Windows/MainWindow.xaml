<Window x:Class="Tabrilo.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tabrilo.Windows"
        Title="Tabrilo" Height="620" Width="730" MinWidth="600" MinHeight="410"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="{DynamicResource BodyFontSize}">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Home" Command="{Binding Dispatch}" CommandParameter="home"/>
                <Button Content="Recent" Command="{Binding Dispatch}" CommandParameter="recent"/>
                <Button Content="Jobs" Command="{Binding Dispatch}" CommandParameter="results"/>
                <Button Content="Settings" Command="{Binding Dispatch}" CommandParameter="settings"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="32" Height="32" Margin="0,0,8,0">
                    <Canvas Width="256" Height="256">
                        <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="52" RadiusY="52" Fill="#111820"/>
                        <Path Data="M48,78 L179,54 208,79 73,107 Z" Fill="#5EEAD4"/>
                        <Path Data="M73,107 L208,79 184,111 144,120 144,185 108,208 108,127 73,134 Z" Fill="#22AA9A"/>
                        <Path Data="M108,127 L144,120 144,185 108,208 Z" Fill="#0F766E"/>
                        <Path Data="M48,78 L73,107 73,134 48,108 Z" Fill="#138E83"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Tabrilo" FontWeight="SemiBold" FontSize="{DynamicResource TitleFontSize}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="Body"/>
        </ScrollViewer>
        <Border Grid.Row="2" CornerRadius="8" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Background="{DynamicResource Surface}" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel job" Command="{Binding CancelJob}" Margin="8,0,0,0"
                        Visibility="{Binding ProgressVisibility}"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
