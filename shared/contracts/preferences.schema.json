{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "enum": [1, 2]
    },
    "modeKeys": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["Shift", "Ctrl", "Alt"] } },
    "showWebP": { "type": "boolean" },
    "checkUpdatesOnStartup": { "type": "boolean", "default": false },
    "officeExecutable": { "type": ["string", "null"] },
    "appearance": {
      "enum": [
        "System",
        "Dark",
        "Light"
      ]
    },
    "keepHistory": {
      "type": "boolean"
    },
    "useTray": {
      "type": "boolean"
    },
    "startAtLogin": {
      "type": "boolean"
    },
    "dragModifier": {
      "enum": [
        "Shift",
        "Ctrl",
        "Alt",
        "Off"
      ]
    },
    "dragButton": {
      "enum": ["Primary", "Secondary"]
    },
    "exportDirectory": {
      "type": [
        "string",
        "null"
      ]
    },
    "clipboardDirectory": {
      "type": ["string", "null"]
    },
    "jpegQuality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "webPQuality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "shortcuts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "favorites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "uniqueItems": true
    },
    "recent": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "operation",
          "path",
          "created"
        ],
        "properties": {
          "operation": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
