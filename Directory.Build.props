<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- GitHub's managed NuGet dependency submission restores projects on Linux. -->
    <EnableWindowsTargeting Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(RUNNER_OS)' == 'Linux'">true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
